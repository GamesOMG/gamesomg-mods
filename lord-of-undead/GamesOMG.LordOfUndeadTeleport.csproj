<!-- GamesOMG Teleport for Lord of Undead: a BepInEx 6 IL2CPP plugin.
     References, all local, none shipped (Private=false):
       .deps/bepinex   the pinned be.793 loader (fetch-dependency.ps1): BepInEx's own DLLs, and the .NET 6.0.7 runtime it
                       ships (dotnet/), compiled against directly: the exact framework the game loads this DLL into
       .deps/interop   the game's interop assemblies, built offline by tools/interop-gen from GameAssembly.dll +
                       global-metadata.dat (the game never runs). Stripped API only: see tools/interop-gen/Program.cs -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GamesOMG.LordOfUndeadTeleport</AssemblyName>
    <!-- the ONE version: the BepInPlugin attribute, the DLL's FileVersion and the zip names follow it; release.ps1 checks CHANGELOG.md -->
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoStdLib>true</NoStdLib>
    <NoCompilerStandardLib>true</NoCompilerStandardLib>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NuGetAudit>false</NuGetAudit>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <Deps>.deps/bepinex</Deps>
    <Interop>.deps/interop</Interop>
  </PropertyGroup>
  <!-- the test-only survey build: -p:Survey=true. Its own DLL name and folders; src/Survey/ is compiled only here, and
       release.ps1 refuses a release DLL that carries it. It never ships. -->
  <PropertyGroup Condition="'$(Survey)' == 'true'">
    <AssemblyName>GamesOMG.LordOfUndeadTeleport.Survey</AssemblyName>
    <DefineConstants>$(DefineConstants);SURVEY</DefineConstants>
    <OutputPath>bin/Survey/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/Survey/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="AI_Assisted_Creation" Value="This assembly was created with the assistance of Generative AI (Anthropic Claude), directed by GamesOMG." />
    <AssemblyMetadata Include="AI_Model_Vendor" Value="Anthropic" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="src/Survey/*.cs" Condition="'$(Survey)' == 'true'" />
    <!-- every pin of the map with its landing (gamesomg-site tools/lord-of-undead-map/tp/landings.py) -->
    <EmbeddedResource Include="data/places.tsv" LogicalName="places.tsv" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(Deps)/dotnet/System.Private.CoreLib.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Runtime.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Collections.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Linq.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Text.RegularExpressions.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Runtime.InteropServices.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/System.Console.dll" Private="false" />
    <Reference Include="$(Deps)/dotnet/netstandard.dll" Private="false" />
    <Reference Include="$(Deps)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(Deps)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(Deps)/BepInEx/core/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(Deps)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(Deps)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)/Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.AIModule.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(Interop)/UnityEngine.InputModule.dll" Private="false" />
    <Reference Include="$(Interop)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(Interop)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Interop)/R3.dll" Private="false" Condition="'$(Survey)' == 'true'" />
  </ItemGroup>
  <Target Name="GeneratePluginVersion" BeforeTargets="BeforeCompile;CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)PluginVersion.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="// generated from the csproj's &lt;Version&gt;: do not edit;namespace GamesOMG.LordOfUndeadTeleport { internal static class PluginVersion { public const string Value = &quot;$(Version)&quot;%3B } }" />
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)PluginVersion.g.cs" />
      <Compile Include="$(IntermediateOutputPath)PluginVersion.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)PluginVersion.g.cs" />
    </ItemGroup>
  </Target>
  <Target Name="CheckReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Deps)/BepInEx/core/BepInEx.Unity.IL2CPP.dll')" Text="Run fetch-dependency.ps1 first (the pinned BepInEx be.793)." />
    <Error Condition="!Exists('$(Interop)/Assembly-CSharp.dll')" Text="Build the interop first: dotnet run -c Release --project tools/interop-gen -- &quot;&lt;Lord of Undead folder&gt;&quot; .deps/interop" />
  </Target>
</Project>
